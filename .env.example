# Halo configuration. Copy to `.env` in the repo root before starting the server.

# Port the API + Socket.IO server listens on (the Vite dev server proxies to it).
PORT=4000

# Port the Vite dev server listens on.
CLIENT_PORT=3000

# Where the SQLite file lives (relative paths resolve from the repo root).
HALO_DB=server/data/halo.db

# Where uploaded images are written.
HALO_UPLOADS=server/uploads

# Secret used to sign session cookies. Set a long random string in production.
HALO_SECRET=change-me-in-production

# Set to "production" when serving behind HTTPS so cookies get the Secure flag.
NODE_ENV=development
